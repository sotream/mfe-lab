{
  "name": "mfe-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "seed": "pnpm -r --if-present seed",
    "seed:reset": "pnpm --filter @mfe/api seed:reset",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p . && pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "e2e:docker": "E2E_TARGET=docker playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@eslint/js": "^10.0.1",
    "@module-federation/enhanced": "^2.9.3",
    "@playwright/test": "^1.65.1",
    "@rspack/cli": "^2.3.3",
    "@rspack/core": "^2.3.3",
    "@rspack/dev-server": "^2.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "eslint": "^10.15",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "^7.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14",
    "jsdom": "^31",
    "prettier": "^3.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73",
    "vite": "^8.3",
    "vitest": "^5.1"
  }
}
