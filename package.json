{
  "name": "mfe-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "seed": "pnpm -r --if-present seed",
    "seed:reset": "pnpm --filter @mfe/api seed:reset",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26",
    "eslint": "^10.15",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.14",
    "prettier": "^3.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73",
    "vite": "^8.3",
    "vitest": "^5.1"
  }
}
