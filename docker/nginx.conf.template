server {
  listen ${PORT};
  root /usr/share/nginx/html;
  add_header Access-Control-Allow-Origin * always;

  location /api/ {
    proxy_pass http://api:4000/;
  }

  # Remote entry points must never be cached, so a restarted remote is picked up.
  location ~ ^/(mf-manifest\.json|remoteEntry\.js)$ {
    add_header Access-Control-Allow-Origin * always;
    add_header Cache-Control no-store always;
  }

  # Content-hashed assets (16 hex chars) never change.
  # Quoted: nginx needs quotes around a regex with braces.
  location ~ "^/(.+\.)?[0-9a-f]{16}\.(js|css|woff2)$" {
    add_header Access-Control-Allow-Origin * always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    try_files $uri /index.html;
  }
}
