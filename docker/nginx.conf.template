server {
  listen ${PORT};
  root /usr/share/nginx/html;
  # add_header in a location replaces the inherited ones, so those locations repeat CORS and nosniff.
  add_header Access-Control-Allow-Origin * always;
  add_header X-Content-Type-Options nosniff always;
  # Every container gets the same CSP (remotes load only from themselves, so it is harmless there).
  # Mirrors scripts/vercel-config.ts. Remote origins are the local stack (docker-compose ports).
  # style-src 'unsafe-inline': React style props and the Vue remote's Shadow DOM <style>.
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' http://localhost:3001 http://localhost:3002 http://localhost:3003; style-src 'self' 'unsafe-inline' http://localhost:3001 http://localhost:3002 http://localhost:3003; connect-src 'self' http://localhost:3001 http://localhost:3002 http://localhost:3003; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  location /api/ {
    proxy_pass http://api:4000/;
  }

  # Remote entry points are always revalidated (no-cache), so a restarted remote is picked up.
  location ~ ^/(mf-manifest\.json|remoteEntry\.js)$ {
    add_header Access-Control-Allow-Origin * always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-cache always;
  }

  # Content-hashed assets (16 hex chars) never change.
  # Quoted: nginx needs quotes around a regex with braces.
  location ~ "^/(.+\.)?[0-9a-f]{16}\.(js|css|woff2)$" {
    add_header Access-Control-Allow-Origin * always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    try_files $uri /index.html;
  }
}
