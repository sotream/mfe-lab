{
  "name": "@mfe/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "seed": "node src/seed.ts",
    "seed:reset": "node src/seed.ts --reset",
    "typecheck": "tsc --noEmit -p .",
    "migrate": "node src/db.ts",
    "build": "rolldown -c"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "catalog:",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "rolldown": "^1.3.3"
  },
  "engines": {
    "node": "26.x"
  }
}
