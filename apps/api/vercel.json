{
  "framework": null,
  "regions": ["fra1"],
  "installCommand": "pnpm install --frozen-lockfile --filter @mfe/api...",
  "buildCommand": "pnpm build && mkdir -p public",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/cron/reseed",
      "schedule": "0 3 * * *"
    }
  ]
}
